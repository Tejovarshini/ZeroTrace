body {
  font-family: 'Segoe UI', sans-serif;
  margin: 0;
  background-color: #f4f4f4;
  color: #333;
}

nav {
  background-color: #2e7d32;
  padding: 1rem;
  text-align: center;
}

nav a {
  color: white;
  margin: 0 1rem;
  text-decoration: none;
  font-weight: bold;
}

header {
  background-color: #81c784;
  padding: 2rem;
  text-align: center;
}

main {
  padding: 2rem;
}

footer {
  background-color: #e0e0e0;
  text-align: center;
  padding: 1rem;
  font-size: 0.9rem;
}

form {
  display: flex;
  flex-direction: column;
  max-width: 400px;
  margin: auto;
}

input, textarea {
  margin-bottom: 1rem;
  padding: 0.5rem;
  font-size: 1rem;
}

button {
  background-color: #388e3c;
  color: white;
  padding: 0.75rem;
  border: none;
  cursor: pointer;
}

button:hover {
  background-color: #2e7d32;
}
